# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/tests
/test-results
/playwright-report

# 本地 UI 截图产物（任务详情抽屉视觉验收）
/.tmp-shots/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
/app/generated/prisma

# IDE and AI assistants
.agents/
.claude/
.windsurf/
.vscode/
.idea/

# Documentation (project-specific plans)
DEVELOPMENT_WORKFLOW.md
PROJECT_PLAN.md
AGENTS.md
CLAUDE.md

# Skills
skills-lock.json

# Node cache with Chinese characters
你的node_cache文件夹路径/

# Utility scripts (personal tooling, not part of source)
/scripts/

# Local crash-dump investigation (Windows dumps + analysis output, ~189MB)
/.crash-investigation/

# Generated disk usage report (local tooling output)
/storage-report.html
