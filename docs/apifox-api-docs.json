    "/api/projects/{id}/cards": {
      "post": {
        "tags": ["Cards"],
        "summary": "创建卡片",
        "description": "在指定项目的某个列中创建新卡片，支持设置负责人、优先级、标签等",
        "operationId": "createCard",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "项目 ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title", "columnId"],
                "properties": {
                  "title": {
                    "type": "string",
                    "description": "卡片标题",
                    "example": "完成首页设计"
                  },
                  "description": {
                    "type": "string",
                    "nullable": true,
                    "description": "卡片简短描述",
                    "example": "根据需求文档完成首页 UI 设计"
                  },
                  "content": {
                    "type": "string",
                    "nullable": true,
                    "description": "卡片详细内容（支持 Markdown）",
                    "example": "## 需求\n- 响应式设计\n- 深色模式支持"
                  },
                  "priority": {
                    "type": "string",
                    "enum": ["LOW", "MEDIUM", "HIGH"],
                    "description": "优先级，默认为 MEDIUM",
                    "example": "HIGH"
                  },
                  "columnId": {
                    "type": "string",
                    "description": "所属列 ID",
                    "example": "clm_abc123"
                  },
                  "assigneeId": {
                    "type": "string",
                    "nullable": true,
                    "description": "负责人用户 ID",
                    "example": "usr_xyz789"
                  },
                  "labelIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "标签 ID 数组",
                    "example": ["lbl_001", "lbl_002"]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "卡片创建成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseCard"
                }
              }
            }
          },
          "400": {
            "description": "缺少必要参数 title 或 columnId",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "未登录",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "无权操作该项目",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "列不存在或不属于该项目",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "cookieAuth": []
          }
        ]
      }
    },
    "/api/cards/{id}": {
      "patch": {
        "tags": ["Cards"],
        "summary": "更新卡片",
        "description": "更新卡片的标题、描述、内容、优先级、截止日期、负责人或标签",
        "operationId": "updateCard",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "卡片 ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "description": "卡片标题",
                    "example": "更新后的标题"
                  },
                  "description": {
                    "type": "string",
                    "nullable": true,
                    "description": "卡片简短描述",
                    "example": "更新后的描述"
                  },
                  "content": {
                    "type": "string",
                    "nullable": true,
                    "description": "卡片详细内容",
                    "example": "更新后的详细内容"
                  },
                  "priority": {
                    "type": "string",
                    "enum": ["LOW", "MEDIUM", "HIGH"],
                    "description": "优先级",
                    "example": "HIGH"
                  },
                  "dueDate": {
                    "type": "string",
                    "format": "date-time",
                    "nullable": true,
                    "description": "截止日期（ISO 8601 格式）",
                    "example": "2026-12-31T23:59:59.000Z"
                  },
                  "assigneeId": {
                    "type": "string",
                    "nullable": true,
                    "description": "负责人用户 ID，null 表示移除负责人",
                    "example": "usr_xyz789"
                  },
                  "labelIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "标签 ID 数组，替换现有标签",
                    "example": ["lbl_001", "lbl_003"]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "卡片更新成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseCard"
                }
              }
            }
          },
          "400": {
            "description": "没有提供需要更新的字段或标题为空",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "未登录",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "无权操作该卡片",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "卡片不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "cookieAuth": []
          }
        ]
      },
      "delete": {
        "tags": ["Cards"],
        "summary": "删除卡片",
        "description": "删除指定卡片及其关联的标签和附件",
        "operationId": "deleteCard",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "卡片 ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "卡片删除成功",
