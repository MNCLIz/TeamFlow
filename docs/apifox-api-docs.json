    "/api/cards/{id}/move": {
      "post": {
        "tags": ["Cards"],
        "summary": "移动卡片",
        "description": "将卡片移动到同一项目内的其他列或调整顺序，支持跨栏移动",
        "operationId": "moveCard",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "卡片 ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["columnId", "order"],
                "properties": {
                  "columnId": {
                    "type": "string",
                    "description": "目标列 ID",
                    "example": "clm_def456"
                  },
                  "order": {
                    "type": "number",
                    "format": "float",
                    "description": "在新列中的排序值（Float 类型，支持小数）",
                    "example": 1.5
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "卡片移动成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseCard"
